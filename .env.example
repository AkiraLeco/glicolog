# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API Keys). Ambas as chaves são públicas por natureza;
# a proteção dos dados é feita pelo Row Level Security no banco.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
